set -eu -o pipefail

BINDIR="$(dirname "$(realpath "$0")")"

: "${ALCLESS_INSTANCE:=default}"
: "${ALCLESS_SHELL:=}"
: "${ALCLESS_WORKDIR:=}"
: "${ALCLESSCTL:="${BINDIR}"/alclessctl}"
ARGS=()

if [ "$#" -ge 1 ]; then
	case "$1" in
	"-h" | "--help")
		base="$(basename "$0")"
		echo "Usage: ${base} [FLAGS...] [COMMAND...]"
		echo
		echo "${base} is an alias for \`alclessctl shell ${ALCLESS_INSTANCE}\`."
		echo
		echo "Recognized environment variables:"
		echo "- ALCLESS_INSTANCE"
		echo "- ALCLESS_SHELL"
		echo "- ALCLESS_WORKDIR"
		echo "- ALCLESSCTL"
		echo
		echo "See \`alclessctl shell --help\` for further information."

		exit 0
		;;
	"-v" | "--version")
		exec "${ALCLESSCTL}" "$@"
		;;
	"create" | "delete" | "list" | "shell")
		echo >&2 "WARNING: Perhaps you meant: ${ALCLESSCTL} $1 ..."
		;;
	esac
fi

# Consume the leading flags, so that they can be passed to `alclessctl shell`
# before the instance name.
# Parsing stops at the first non-flag argument (or at "--"), as the remaining
# arguments belong to the command to be executed, e.g. `alcless --plain uname -a`.
while [ "$#" -ge 1 ]; do
	case "$1" in
	"--")
		shift
		break
		;;
	"--shell" | "--workdir")
		# These flags take a value as the next argument
		if [ "$#" -lt 2 ]; then
			echo >&2 "ERROR: flag needs an argument: $1"
			exit 1
		fi
		ARGS+=("$1" "$2")
		shift 2
		;;
	-*)
		ARGS+=("$1")
		shift
		;;
	*)
		break
		;;
	esac
done

if [ -n "${ALCLESS_SHELL}" ]; then
	ARGS+=("--shell"="${ALCLESS_SHELL}")
fi
if [ -n "${ALCLESS_WORKDIR}" ]; then
	ARGS+=("--workdir"="${ALCLESS_WORKDIR}")
fi
ARGS+=("${ALCLESS_INSTANCE}")
ARGS+=("$@")
exec "${ALCLESSCTL}" shell "${ARGS[@]}"
